# Railway Deployment Configuration
# Railway automatically detects Dockerfile when present in directory.

# Example Remote SQL connection (e.g., PostgreSQL on Railway, Supabase, Neon, AWS RDS, CockroachDB):
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@roundhouse.proxy.rlwy.net:PORT/railway

# Optional port (Railway injects PORT automatically into runtime)
PORT=8000
